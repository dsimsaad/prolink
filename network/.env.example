# Names of the environment variables used by network/. No values here.
# The code does not read this file; set the variables in your shell.

# SMTP client
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Test user for the local mini SMTP server (AUTH is off when these are not set)
FAKE_SMTP_USER=
FAKE_SMTP_PASSWORD=

# Status relay database source only (--source db); use a read-only database user
DATABASE_URL=
