# ==============================================================================
# ProLink Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR VALUES TO VERSION CONTROL.
# Copy this file to .env.local (for web) or relevant service env files.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (web) - Client-accessible variables (prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Used by web (Next.js client/SSR) to connect to Supabase
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects use PUBLISHABLE_KEY; older ones use ANON_KEY.
# The code reads PUBLISHABLE_KEY first and falls back to ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by web to call the C# Core Engine API (or replacement Python backend)
NEXT_PUBLIC_API_URL=

# Used by web to call the Python Insight Service (FastAPI)
NEXT_PUBLIC_INSIGHT_URL=

# ------------------------------------------------------------------------------
# Backend Services (C# Core Engine / Python Insight Service)
# ------------------------------------------------------------------------------
# Used by C# API / Python Insight Service for Supabase REST and internal calls
SUPABASE_URL=

# Server-only service role key (NEVER expose to frontend or web client)
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification settings for C# API (issuer, audience, secret / public keys)
SUPABASE_JWT_SETTINGS=

# Supabase Postgres pooled connection string (used by C# API & Python analytics)
DATABASE_URL=

# Used by C# Core Engine API if calling Python Insight Service internally
INSIGHT_URL=

# CORS allowed origins (comma-separated origins allowed to call API services)
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Computer Networks Modules (network/)
# ------------------------------------------------------------------------------
# SMTP configuration used by custom SMTP client
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
