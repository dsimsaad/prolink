# ProLink Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR VALUES TO VERSION CONTROL.
# Copy this file to .env.local (for web) or relevant service env files.

# Frontend (web) - Client-accessible variables (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_INSIGHT_URL=
# Live status feed (leave UNSET on Vercel; set to ws://127.0.0.1:9099 only for local demos)
NEXT_PUBLIC_STATUS_FEED_URL=

# Support Desk / Contact Form SMTP Configuration
# Local development demo settings (Python aiosmtpd on 127.0.0.1:2525 without auth):
# SUPPORT_SMTP_HOST=127.0.0.1
# SUPPORT_SMTP_PORT=2525
# SUPPORT_SMTP_USER=
# SUPPORT_SMTP_PASSWORD=
# SUPPORT_INBOX=prolnk.support@gmail.com

# Vercel Production Variables (names only):
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASSWORD=
SUPPORT_INBOX=

# Backend Services on Render (C# Core Engine / Python Insight Service)
SUPABASE_URL=
DATABASE_URL=
ALLOWED_ORIGINS=
RateLimiting__PermitLimit=
RateLimiting__WindowSeconds=
INSIGHT_URL=

# Computer Networks Modules (network/)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
