# ProLink Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR VALUES TO VERSION CONTROL.
# Copy this file to .env.local (for web) or relevant service env files.

# Frontend (web) - Client-accessible variables (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_INSIGHT_URL=

# Backend Services on Render (C# Core Engine / Python Insight Service)
SUPABASE_URL=
DATABASE_URL=
ALLOWED_ORIGINS=
RateLimiting__PermitLimit=
RateLimiting__WindowSeconds=
INSIGHT_URL=

# Computer Networks Modules (network/)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
